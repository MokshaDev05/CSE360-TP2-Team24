% Shared layout for the TP2 Team 24 documents.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{tp2style}[2026/10/25 TP2 Team 24 document style]

\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{XCharter}
\RequirePackage[scale=0.92]{tgheros}
\RequirePackage[scaled=0.88]{beramono}
\RequirePackage[letterpaper,margin=0.85in,headheight=14pt]{geometry}
\RequirePackage[dvipsnames,table]{xcolor}
\RequirePackage{microtype}
\RequirePackage{enumitem}
\RequirePackage{booktabs,tabularx,longtable,array,makecell,multirow}
\RequirePackage{titlesec}
\RequirePackage{fancyhdr}
\RequirePackage{lastpage}
\RequirePackage{tikz}
\usetikzlibrary{positioning,calc,shapes.misc}
\RequirePackage[normalem]{ulem}
\RequirePackage[hidelinks,pdfusetitle]{hyperref}

\definecolor{ink}{HTML}{1F2933}
\definecolor{muted}{HTML}{5B6573}
\definecolor{accent}{HTML}{1F4E9A}
\definecolor{rulegray}{HTML}{C9CED6}
\definecolor{shade}{HTML}{F2F4F7}
\definecolor{added}{HTML}{1F4E9A}
\definecolor{deleted}{HTML}{B42318}
\definecolor{done}{HTML}{1E7B3C}
\definecolor{doing}{HTML}{B45309}
\definecolor{todo}{HTML}{5B6573}

\color{ink}
\setlength{\parindent}{0pt}
\setlength{\parskip}{5pt}
\setlength{\emergencystretch}{2em}
\setlist{nosep,leftmargin=1.4em,topsep=2pt}
\renewcommand{\arraystretch}{1.25}

\titleformat{\section}{\sffamily\Large\bfseries\color{accent}}{\thesection}{0.6em}{}
\titleformat{\subsection}{\sffamily\large\bfseries}{\thesubsection}{0.6em}{}
\titleformat{\subsubsection}{\sffamily\normalsize\bfseries}{}{0em}{}
\titlespacing*{\section}{0pt}{14pt}{6pt}
\titlespacing*{\subsection}{0pt}{10pt}{4pt}
\titlespacing*{\subsubsection}{0pt}{8pt}{2pt}

% \doctitle{Title}{Subtitle line}
\newcommand{\doctitle}[2]{%
  {\sffamily\bfseries\LARGE #1\par}\vspace{3pt}
  {\sffamily\color{muted} #2\par}\vspace{2pt}
  {\color{rulegray}\rule{\linewidth}{0.6pt}}\par\vspace{4pt}}

\newcommand{\team}{CSE 360, Fall 2026 (C) \textperiodcentered{} Team 24: Arush Ugal, Karan Patel,
  Anirudh B, Pranjal Ganvir, Moksha Dev}

\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyfoot[L]{\sffamily\scriptsize\color{muted}\leftmark}
\fancyfoot[R]{\sffamily\scriptsize\color{muted}Page \thepage\ of \pageref*{LastPage}}

% Track changes.
\newcommand{\add}[1]{{\color{added}\uline{#1}}}
\newcommand{\del}[1]{{\color{deleted}\sout{#1}}}
\newcommand{\why}[1]{\par\smallskip{\small\sffamily\color{muted}\textbf{Why changed:} #1}\par}
\newcommand{\unchanged}{\par{\small\sffamily\color{muted}No change.}\par}

% Status labels.
\newcommand{\Done}{\textcolor{done}{\sffamily\bfseries Done}}
\newcommand{\Doing}{\textcolor{doing}{\sffamily\bfseries In Progress}}
\newcommand{\ToDo}{\textcolor{todo}{\sffamily\bfseries To Do}}

\newcommand{\code}[1]{\texttt{#1}}
\endinput
